# Copy to server/.env and fill in. Never commit the real .env.

# --- Required (server refuses to start without these) ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
JWT_SECRET=<long random string>
# Encryption at rest (AES-256-GCM). LOSING A KEY = LOSING THE DATA IT ENCRYPTED.
# Comma-separated, NEWEST FIRST: the first encrypts, all decrypt. Rotate without downtime → docs/KEY_ROTATION.md
# Generate: npm run keys:generate
ENCRYPTION_KEYS=<long random string>
# Keyed hashes for lookups (email login, Web names). Comma-separated, newest first.
BLIND_INDEX_KEYS=<long random string>
# Legacy names (still honoured, treated as the OLDEST keys — keep them until `npm run keys:status` says 0 left)
SERVER_ENCRYPTION_KEY=
NEW_SERVER_ENCRYPTION_KEY=
# JWT rotation: previous secret(s) still accepted for 30 days after changing JWT_SECRET
JWT_SECRET_OLD=
# Set to false to run the re-encryption sweep only via `npm run keys:rotate`
KEY_ROTATION_ON_START=

# --- Runtime ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Set automatically on Render
RENDER=

# --- AI providers (comma-separated for multiple keys) ---
GROQ_API_KEYS=
GEMINI_API_KEYS=
# Legacy single-key fallbacks (prefer the plural vars above)
GROQ_API_KEY=
GEMINI_API_KEY=
API_KEY=

# Optional: override model chains (comma-separated, tried in order; see services/llm.ts for defaults)
AI_CHAT_MODELS=
AI_VISION_MODELS=
AI_BRAIN_MODELS=
AI_GEMINI_FALLBACK_MODEL=

# Voice/vision microservice (Hugging Face Space)
BRAIN_SERVER_URL=https://<your-space>.hf.space
# Must match BRAIN_SHARED_SECRET set in the Hugging Face Space secrets
BRAIN_SHARED_SECRET=<long random string>

# --- Web Push for browser/PWA users (no Firebase needed) ---
# Generate once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Music search ---
YOUTUBE_API_KEY=

# --- Optional: shared rate limiting ---
REDIS_URL=

# GIF / meme reactions in chat (optional — off when neither is set). Only a 2-5 word search phrase is sent.
# GIPHY: https://developers.giphy.com (use a production key, rating=pg is enforced)
GIPHY_API_KEY=
# or Tenor (Google): contentfilter=high is enforced
TENOR_API_KEY=

# Crash reporting (optional, ROADMAP 7.2). Leave empty = off. Events are PII-scrubbed (src/utils/scrub.ts).
SENTRY_DSN=

# Sarvam AI voice notes (Indian, human-sounding). Without a key, voice notes use the HF Space (Kokoro) as before.
# Get a key at https://indus.sarvam.ai/key-management (Sarvam dashboard → API keys). ~Rs 3 per 1,000 characters (bulbul:v3), Rs 100 free credit on signup.
SARVAM_API_KEY=
# Optional: model and voices (speaker names depend on the model)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_VOICE_AASTHA=shreya
SARVAM_VOICE_AASTIK=rohan
