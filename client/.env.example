# Copy to client/.env and fill in. Never commit the real .env.
# Everything prefixed VITE_ is PUBLIC — it is baked into the browser bundle.
# Never put API keys (Groq, Gemini, Razorpay secret, etc.) here.

# Backend API base URL (web builds). Native builds currently use the Render URL hard-coded in src/services/api.ts.
VITE_API_URL=http://localhost:5000/api

# Crash reporting (optional, ROADMAP 7.2). Public DSN from sentry.io → Project → Client Keys. Empty = off.
VITE_SENTRY_DSN=
